{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "70S3A3 单机启动器",
  "version": "0.1.0",
  "identifier": "com.70s3a3.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "70S3A3 单机启动器 · 服务端与 GM 控制台",
        "width": 1180,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#15181d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
